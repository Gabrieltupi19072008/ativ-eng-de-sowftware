# Copie este arquivo para .env.local e ajuste se precisar.

# Endereço da API em Python (back-end). Padrão: http://localhost:8000
VITE_API_URL=http://localhost:8000

# true = não usa o back-end: tudo é simulado no navegador (localStorage), só para demonstração.
VITE_USE_MOCK=false

# Acesso rápido do login (contas de teste). Aparece sozinho em desenvolvimento; no site publicado fica escondido.
# VITE_DEMO_ACCESS=true

# Na Vercel: VITE_API_URL=/api (o vercel.json repassa /api para a API na Render, assim o cookie de login funciona sem domínio próprio)
