# Copie para .env (o .env NÃO vai para o GitHub) e preencha.

# --- Banco de dados (SQL Server) ---
DB_SERVER=localhost,1433
DB_NAME=loja_quadros
DB_USER=sa
DB_PASSWORD=troque-esta-senha

# --- Sessão ---
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_HOURS=8
# Em produção (HTTPS) use COOKIE_SECURE=true
COOKIE_SECURE=false

# --- Front-end e imagens ---
# Endereços do front-end autorizados a chamar a API (separe por vírgula)
CORS_ORIGINS=http://localhost:5173
# Endereço público desta API (usado nas URLs das imagens enviadas)
API_PUBLIC_URL=http://localhost:8000
MAX_IMAGE_MB=10

# development ou production (o seed recusa rodar em production)
ENVIRONMENT=development

# --- Pedidos ---
# Horas para pagar: depois disso o pedido é cancelado e a obra volta para a vitrine
ORDER_EXPIRY_HOURS=24
# "Simular pagamento" (marca como pago SEM cobrar nada). Só funciona em development; em production é sempre desligado.
FAKE_PAYMENTS=true

# --- Recuperação de senha (e-mail) ---
# Endereço do site, usado no link enviado por e-mail
FRONTEND_URL=http://localhost:5173
# Sem SMTP_HOST o e-mail NÃO é enviado: em development o link aparece no terminal da API.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Nambá Galerie <nao-responda@exemplo.com>
