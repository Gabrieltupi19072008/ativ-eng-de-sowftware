# Copie para .env (o .env NÃO vai para o GitHub) e preencha.

# --- Banco de dados (PostgreSQL) ---
# Local (contêiner do README):  postgresql://postgres:troque-esta-senha@localhost:5432/loja_quadros
# Supabase: copie a "Connection string" do painel (use a opção "Session pooler", que funciona em IPv4)
DATABASE_URL=postgresql://postgres:troque-esta-senha@localhost:5432/loja_quadros
# Fuso das datas (o esquema do banco também usa horário de Brasília)
TZ=America/Sao_Paulo

# --- Sessão ---
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_HOURS=8
# Em produção (HTTPS) use COOKIE_SECURE=true
COOKIE_SECURE=false

# --- Front-end e imagens ---
# Endereços do front-end autorizados a chamar a API (separe por vírgula)
CORS_ORIGINS=http://localhost:5173
# Endereço público desta API (usado nas URLs das imagens enviadas)
API_PUBLIC_URL=http://localhost:8000
MAX_IMAGE_MB=10
# Imagens no Supabase Storage (obrigatório em hospedagem grátis). Sem isto, as imagens ficam na pasta uploads/ (só desenvolvimento).
# Crie um bucket PÚBLICO chamado "obras" (Storage > New bucket). A chave "service_role" (Project Settings > API) é SECRETA:
# só aqui e no painel da hospedagem, nunca no front-end nem no GitHub.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=obras

# development ou production (o seed recusa rodar em production)
ENVIRONMENT=development

# --- Pedidos ---
# Horas para pagar: depois disso o pedido é cancelado e a obra volta para a vitrine
ORDER_EXPIRY_HOURS=24
# "Simular pagamento" (marca como pago SEM cobrar nada). Só funciona em development; em production é sempre desligado.
FAKE_PAYMENTS=true

# --- Recuperação de senha (e-mail) ---
# Endereço do site, usado no link enviado por e-mail
FRONTEND_URL=http://localhost:5173
# Sem nenhum provedor o e-mail NÃO é enviado: em development o link aparece no terminal da API.
# Opção recomendada: Brevo pela API (plano grátis; basta verificar UM e-mail remetente, sem domínio próprio).
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=   # o mesmo e-mail verificado em Brevo > Senders
# BREVO_SENDER_NAME=Nambá Galerie
# Alternativa: SMTP (Gmail com "senha de app"). Hospedagens grátis costumam bloquear essas portas.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Nambá Galerie <nao-responda@exemplo.com>
